{
 "sentinelone:channel:agents": {
  "source": "https://raw.githubusercontent.com/splunk/SA-SentinelOneDevices/main/SA-SentinelOneDevices/default/savedsearches.conf",
  "api_route": "GET /web/api/v2.1/agents",
  "fields": [
   "accountName",
   "activeThreats",
   "agentVersion",
   "allowRemoteShell",
   "appsVulnerabilityStatus",
   "computerName",
   "detectionState",
   "domain",
   "encryptedApplications",
   "externalIp",
   "firewallEnabled",
   "groupName",
   "infected",
   "isActive",
   "isDecommissioned",
   "isPendingUninstall",
   "isUninstalled",
   "isUpToDate",
   "lastActiveDate",
   "lastLoggedInUserName",
   "locationEnabled",
   "locationType",
   "machineType",
   "mitigationMode",
   "mitigationModeSuspicious",
   "modelName",
   "networkInterfaces",
   "networkInterfaces[*].physical",
   "operationalState",
   "osName",
   "osType",
   "rangerStatus",
   "rangerVersion",
   "remoteProfilingState",
   "scanFinishedAt",
   "siteName",
   "threatRebootRequired",
   "updatedAt",
   "uuid"
  ]
 }
}
