{
  "content": {
    "ADD_EXTRA_TIME_FIELDS": "True",
    "ANNOTATE_PUNCT": true,
    "AUTO_KV_JSON": "true",
    "BREAK_ONLY_BEFORE": "^\\*",
    "BREAK_ONLY_BEFORE_DATE": true,
    "CHARSET": "UTF-8",
    "CHECK_METHOD": "modtime",
    "DATETIME_CONFIG": "/etc/datetime.xml",
    "DEPTH_LIMIT": "1000",
    "DETERMINE_TIMESTAMP_DATE_WITH_SYSTEM_TIME": "false",
    "EVAL-app": "\"splunk\"",
    "EVAL-data.search_props.label": "if(isnull('data.search_props.label') AND isnotnull('data.search_props.sid'), \"N/A\", 'data.search_props.label')",
    "EVAL-data.search_props.provenance": "if(isnull('data.search_props.provenance') AND isnotnull('data.search_props.sid'), \"unknown\", 'data.search_props.provenance')",
    "EVAL-from_repo": "'data.from_repo'",
    "EVAL-object_attrs": "json_extract(_raw,\"data.attributes\")",
    "EVAL-object_name": "mvindex('data.asset_uri{}', 3)",
    "EVAL-object_type": "mvindex('data.asset_uri{}', 2)",
    "EVAL-optype_desc": "'data.optype_desc'",
    "EVAL-owner": "mvindex('data.asset_uri{}', 0)",
    "EVAL-reason": "json_extract(_raw,\"data.reason\")",
    "EVAL-status": "case(status==\"success\", \"completed\", status==\"skipped\", \"skipped\", status==\"continued\", \"deferred\")",
    "EVAL-to_repo": "'data.to_repo'",
    "EVAL-vendor_product": "\"splunk\"",
    "EVENT_BREAKER": "([\\r\\n]+)(?:\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3})",
    "EVENT_BREAKER_ENABLE": "true",
    "EXTRACT-1": "(?<_KEY_1>\\S+)::(?<_VAL_1>\\S+)",
    "EXTRACT-GUID": "(?i)(?!=\\w)(?:objectguid|guid)\\s*=\\s*(?<guid_lookup>[\\w\\-]+)",
    "EXTRACT-SID": "objectSid\\s*=\\s*(?<sid_lookup>\\S+)",
    "EXTRACT-apiEndTime": "apiEndTime=\\'(?<apiEndTime>[^\\']*?)\\'",
    "EXTRACT-apiStartTime": "apiStartTime=\\'(?<apiStartTime>[^\\']*?)\\'",
    "EXTRACT-bundle_dir_reaper_max_ms": "Bundle_Directory_Reaper_Max_Time\\(ms\\)=(?<bundle_dir_reaper_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-bundle_dir_reaper_mean_ms": "Bundle_Directory_Reaper_Mean_Time\\(ms\\)=(?<bundle_dir_reaper_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-compute_search_quota_max_ms": "Compute_Search_Quota_Max_Time\\(ms\\)=(?<compute_search_quota_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-compute_search_quota_mean_ms": "Compute_Search_Quota_Mean_Time\\(ms\\)=(?<compute_search_quota_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-default_rd_fields": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3} (?<component>\\S+) (?<log_level>\\S+) (?<thread_id>\\d+) - (?s)(?<event_message>.*)$",
    "EXTRACT-dispatch_dir_reaper_max_ms": "Dispatch_Directory_Reaper_Max_Time\\(ms\\)=(?<dispatch_dir_reaper_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-dispatch_dir_reaper_mean_ms": "Dispatch_Directory_Reaper_Mean_Time\\(ms\\)=(?<dispatch_dir_reaper_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-enqueue_searches_count": "enqueue_seaches_count=(?<enqueue_searches_count>\\d+)",
    "EXTRACT-extract_spent": "\\s(?<spent>\\d+(\\.\\d+)?)ms$",
    "EXTRACT-fields": "(?i)^(?:[^ ]* ){2}(?:[+\\-]\\d+ )?(?P<log_level>[^ ]*)\\s+(?P<component>[^ ]+) - (?P<event_message>.+)",
    "EXTRACT-get_auth_max_ms": "Get_Authentication_Max_Time\\(ms\\)=(?<get_auth_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-get_auth_mean_ms": "Get_Authentication_Mean_Time\\(ms\\)=(?<get_auth_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-get_bundleList_max_ms": "Get_BundleList_Max_Time\\(ms\\)=(?<get_bundleList_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-get_bundleList_mean_ms": "Get_BundleList_Mean_Time\\(ms\\)=(?<get_bundleList_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-get_serverInfo_max_ms": "Get_ServerInfo_Max_Time\\(ms\\)=(?<get_serverInfo_max_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-get_serverInfo_mean_ms": "Get_ServerInfo_Mean_Time\\(ms\\)=(?<get_serverInfo_mean_ms>\\d+(\\.\\d+)?)",
    "EXTRACT-log_level,app_name,module_name,function_name,process_id": "^(?:[^ \\n]* ){2}(?P<log_level>[^ ]+)\\s+\\[(?P<app_name>[^\\]]+)[^\\[\\n]*\\[(?P<module_name>[^\\]]+)[^ \\n]* \\[(?P<function_name>\\w+)\\]\\s+\\[(?P<process_id>[^\\]]+)",
    "EXTRACT-message": ".*?(message=)(?<message>.*)$",
    "EXTRACT-search_id": "search_id=\\'(?<search_id>[^\\']*?)\\'",
    "EXTRACT-search_string": "search=\\'(?<search>.*?)\\',\\sautojoin",
    "EXTRACT-useragent": "userAgent=(?P<browser>[^ (]+)",
    "FIELDALIAS-cim": "\"actor.name\" ASNEW user \"actor.name\" ASNEW user_name category ASNEW change_type \"data.name\" ASNEW object \"data.type\" ASNEW object_category host ASNEW dest host ASNEW dvc result ASNEW status",
    "FIELD_DELIMITER": "|",
    "HEADER_FIELD_DELIMITER": "|",
    "HEADER_MODE": "firstline",
    "INDEXED_EXTRACTIONS": "json",
    "JSON_TRIM_BRACES_IN_ARRAY_NAMES": "true",
    "KV_MODE": "none",
    "LB_CHUNK_BREAKER_TRUNCATE": "2000000",
    "LEARN_MODEL": true,
    "LEARN_SOURCETYPE": true,
    "LINE_BREAKER": "([\\r\\n]+---splunk-admon-end-of-event---\\r\\n[\\r\\n]*)",
    "LINE_BREAKER_LOOKBEHIND": 100,
    "LOOKUP-dmc_add_instance_info": "dmc_assets host OUTPUTNEW machine search_group",
    "MATCH_LIMIT": "100000",
    "MAX_DAYS_AGO": 2000,
    "MAX_DAYS_HENCE": 2,
    "MAX_DIFF_SECS_AGO": 3600,
    "MAX_DIFF_SECS_HENCE": 604800,
    "MAX_EVENTS": 256,
    "MAX_EXPECTED_EVENT_LINES": "7",
    "MAX_TIMESTAMP_LOOKAHEAD": 128,
    "METRIC-SCHEMA-TRANSFORMS": "metric-schema:log2metrics_default_csv",
    "METRICS_PROTOCOL": "collectd_http",
    "MUST_BREAK_AFTER": "^(?i)terminating\\.\\.\\.",
    "MUST_NOT_BREAK_AFTER": ".*",
    "MUST_NOT_BREAK_BEFORE": "",
    "NO_BINARY_CHECK": true,
    "PREFIX_SOURCETYPE": true,
    "REPORT-1": "stash_extract",
    "REPORT-MESSAGE": "ad-kv",
    "REPORT-access": "access-extractions",
    "REPORT-asl": "bracket-space",
    "REPORT-fields": "splunk-service-extractions",
    "REPORT-st": "db2",
    "REPORT-syslog": "syslog-extractions",
    "REPORT-tcp": "tcpdump-endpoints, colon-kv",
    "SEGMENTATION": "indexing",
    "SEGMENTATION-all": "full",
    "SEGMENTATION-inner": "inner",
    "SEGMENTATION-outer": "outer",
    "SEGMENTATION-raw": "none",
    "SEGMENTATION-standard": "standard",
    "SHOULD_LINEMERGE": false,
    "TIMESTAMP_FIELDS": "time",
    "TIME_FORMAT": "%b %d %H:%M:%S",
    "TIME_PREFIX": "\\[",
    "TRANSFORMS": "syslog-host",
    "TRANSFORMS-EXTRACT": "metrics_field_extraction",
    "TRANSFORMS-blah": "metrics_index_redirect,introspection_disk_objects_metric_name",
    "TRANSFORMS-bloo": "metrics_index_redirect,introspection_resource_usage_metric_name",
    "TRANSFORMS-help": "splunk_help",
    "TRANSFORMS-host": "syslog-host",
    "TRANSFORMS-metricslog": "metrics_index_redirect,metrics_field_extraction,metrics_log_metric_name",
    "TRANSFORMS-nov": "novell-groupwise-arrival,novell-groupwise-queue,novell-groupwise-transfer",
    "TRANSFORMS-sourcetype": "set_sourcetype_to_stash",
    "TRUNCATE": 10000,
    "category": "Structured",
    "description": "JavaScript Object Notation format. For more information, visit http://json.org/",
    "detect_trailing_nulls": "false",
    "eai:acl": null,
    "invalid_cause": "ignored_type",
    "is_valid": true,
    "maxDist": 100,
    "priority": "",
    "pulldown_type": true,
    "sourcetype": "",
    "termFrequencyWeightedDist": "false",
    "trackPipelineLatency": "true",
    "unarchive_cmd_start_mode": "shell"
  }
}
