meta {
  name: Get Log Analytics token
  type: http
  seq: 2
}

post {
  url: {{sentinel_base_url}}/oauth2/v2.0/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: sentinel-mock-client-id
  client_secret: sentinel-mock-client-secret
  grant_type: client_credentials
  scope: https://api.loganalytics.io/.default
}

script:post-response {
  try {
    const value = res.body.access_token;
    if (value !== undefined && value !== null) bru.setVar("sentinel_la_token", String(value));
  } catch (e) {}
}

docs {
  Returns a Logs query API access_token — stored in sentinel_la_token for the requests after it. ARM
  refuses it, and the query refuses an ARM token.
}
