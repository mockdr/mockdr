meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{sentinel_base_url}}/oauth2/v2.0/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: sentinel-mock-client-id
  client_secret: sentinel-mock-client-secret
  grant_type: client_credentials
  scope: https://management.azure.com/.default
}

docs {
  Returns an Azure Resource Manager access_token — copy to sentinel_token.
  A token is for one resource: the Log Analytics query needs its own,
  from "Get Log Analytics token".
}
