meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{sentinel_base_url}}/oauth2/v2.0/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: sentinel-mock-client-id
  client_secret: sentinel-mock-client-secret
  grant_type: client_credentials
  scope: https://management.azure.com/.default
}

script:post-response {
  try {
    const value = res.body.access_token;
    if (value !== undefined && value !== null) bru.setVar("sentinel_token", String(value));
  } catch (e) {}
}

docs {
  Returns an Azure Resource Manager access_token — stored in sentinel_token for the requests after it.
  A token is for one resource: the Log Analytics query needs its own,
  from "Get Log Analytics token".
}
