meta {
  name: List machines
  type: http
  seq: 1
}

get {
  url: {{mde_base_url}}/api/machines?$top=25
  body: none
  auth: none
}

params:query {
  $top: 25
  ~$filter: osBuild eq 22000
}

headers {
  Authorization: Bearer {{mde_token}}
}

script:post-response {
  try {
    const value = res.body.value[0].id;
    if (value !== undefined && value !== null) bru.setVar("mde_machine_id", String(value));
  } catch (e) {}
}
