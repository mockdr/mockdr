meta {
  name: List alerts
  type: http
  seq: 1
}

get {
  url: {{mde_base_url}}/api/alerts?$top=25
  body: none
  auth: none
}

params:query {
  $top: 25
  ~$filter: severity eq 'High'
}

headers {
  Authorization: Bearer {{mde_token}}
}

script:post-response {
  try {
    const value = res.body.value[0].id;
    if (value !== undefined && value !== null) bru.setVar("mde_alert_id", String(value));
  } catch (e) {}
}
