meta {
  name: Run query
  type: http
  seq: 1
}

post {
  url: {{mde_base_url}}/api/advancedqueries/run
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mde_token}}
  Content-Type: application/json
}

body:json {
  {
    "Query": "DeviceInfo | where OSPlatform startswith 'Windows' | summarize Devices=count() by OSPlatform | top 10 by Devices"
  }
}
