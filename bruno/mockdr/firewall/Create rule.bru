meta {
  name: Create rule
  type: http
  seq: 2
}

post {
  url: {{s1_base_url}}/firewall-control
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "name": "Block Outbound 4444",
      "action": "Block",
      "direction": "OUT",
      "protocol": "TCP",
      "remotePort": "4444",
      "status": "Enabled",
      "osType": "windows"
    }
  }
}

script:post-response {
  try {
    const value = (res.body.data[0] || res.body.data).id;
    if (value !== undefined && value !== null) bru.setVar("fw_rule_id", String(value));
  } catch (e) {}
}
