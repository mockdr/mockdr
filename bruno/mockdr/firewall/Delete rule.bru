meta {
  name: Delete rule
  type: http
  seq: 4
}

delete {
  url: {{s1_base_url}}/firewall-control
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "filter": {
      "ids": [
        "{{fw_rule_id}}"
      ]
    }
  }
}
