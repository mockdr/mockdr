meta {
  name: List accounts
  type: http
  seq: 1
}

get {
  url: {{s1_base_url}}/accounts?limit=50
  body: none
  auth: none
}

params:query {
  limit: 50
}

headers {
  Authorization: ApiToken {{s1_token}}
}

script:post-response {
  try {
    const value = res.body.data[0].id;
    if (value !== undefined && value !== null) bru.setVar("account_id", String(value));
  } catch (e) {}
}
