meta {
  name: Create tag
  type: http
  seq: 1
}

post {
  url: {{s1_base_url}}/tag-manager
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "type": "agents",
      "key": "env",
      "value": "production"
    },
    "filter": {
      "siteIds": [
        "{{site_id}}"
      ]
    }
  }
}

script:post-response {
  try {
    const value = (res.body.data[0] || res.body.data).id;
    if (value !== undefined && value !== null) bru.setVar("tag_id", String(value));
  } catch (e) {}
}
