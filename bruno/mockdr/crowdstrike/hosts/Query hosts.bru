meta {
  name: Query hosts
  type: http
  seq: 1
}

get {
  url: {{cs_base_url}}/devices/queries/devices/v1?limit=25
  body: none
  auth: none
}

params:query {
  limit: 25
  ~filter: platform_name:'Windows'
}

headers {
  Authorization: Bearer {{cs_token}}
}

script:post-response {
  try {
    const value = res.body.resources[0];
    if (value !== undefined && value !== null) bru.setVar("cs_host_id", String(value));
  } catch (e) {}
}
