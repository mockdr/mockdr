meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{cs_base_url}}/oauth2/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: cs-mock-admin-client
  client_secret: cs-mock-admin-secret
}

script:post-response {
  try {
    const value = res.body.access_token;
    if (value !== undefined && value !== null) bru.setVar("cs_token", String(value));
  } catch (e) {}
}

docs {
  Returns access_token — stored in cs_token for the requests after it.
  Roles: admin=cs-mock-admin-client/cs-mock-admin-secret,
         viewer=cs-mock-viewer-client/cs-mock-viewer-secret
}
