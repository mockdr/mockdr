meta {
  name: List Managed Devices
  type: http
  seq: 1
}

get {
  url: {{graph_base_url}}/v1.0/deviceManagement/managedDevices?$top=25
  body: none
  auth: none
}

params:query {
  $top: 25
}

headers {
  Authorization: Bearer {{graphToken}}
}

script:post-response {
  try {
    const value = res.body.value[0].id;
    if (value !== undefined && value !== null) bru.setVar("deviceId", String(value));
  } catch (e) {}
}
