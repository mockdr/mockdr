meta {
  name: Create search job
  type: http
  seq: 1
}

post {
  url: {{splunk_base_url}}/services/search/jobs?output_mode=json
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  search: search index=sentinelone | head 100
  earliest_time: -24h
  latest_time: now
}

headers {
  Authorization: Splunk {{splunk_session_key}}
}

params:query {
  output_mode: json
}

script:post-response {
  try {
    const value = res.body.sid;
    if (value !== undefined && value !== null) bru.setVar("splunk_sid", String(value));
  } catch (e) {}
}

docs {
  Returns sid — stored in splunk_sid for the requests after it.
}
