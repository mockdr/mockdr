meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{splunk_base_url}}/services/auth/login?output_mode=json
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: admin
  password: mockdr-admin
}

script:post-response {
  try {
    const value = res.body.sessionKey;
    if (value !== undefined && value !== null) bru.setVar("splunk_session_key", String(value));
  } catch (e) {}
}

docs {
  Returns sessionKey — stored in splunk_session_key for the requests after it.
  Users: admin/mockdr-admin, analyst/mockdr-analyst, viewer/mockdr-viewer
}
