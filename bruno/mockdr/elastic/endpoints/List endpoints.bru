meta {
  name: List endpoints
  type: http
  seq: 1
}

get {
  url: {{kibana_base_url}}/api/endpoint/metadata?page=0&pageSize=25
  body: none
  auth: none
}

params:query {
  page: 0
  pageSize: 25
}

headers {
  Authorization: ApiKey {{es_token}}
  kbn-xsrf: true
}

script:post-response {
  try {
    const value = res.body.data[0].metadata.agent.id;
    if (value !== undefined && value !== null) bru.setVar("es_endpoint_id", String(value));
  } catch (e) {}
}
