meta {
  name: Unisolate endpoint
  type: http
  seq: 3
}

post {
  url: {{kibana_base_url}}/api/endpoint/action/unisolate
  body: json
  auth: none
}

headers {
  Authorization: ApiKey {{es_token}}
  kbn-xsrf: true
  Content-Type: application/json
}

body:json {
  {
    "endpoint_ids": [
      "{{es_endpoint_id}}"
    ],
    "comment": "Investigation complete"
  }
}
