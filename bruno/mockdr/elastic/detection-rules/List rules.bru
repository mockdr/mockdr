meta {
  name: List rules
  type: http
  seq: 1
}

get {
  url: {{kibana_base_url}}/api/detection_engine/rules/_find?per_page=25
  body: none
  auth: none
}

params:query {
  per_page: 25
}

headers {
  Authorization: ApiKey {{es_token}}
  kbn-xsrf: true
}

script:post-response {
  try {
    const value = res.body.data[0].id;
    if (value !== undefined && value !== null) bru.setVar("es_rule_id", String(value));
  } catch (e) {}
}
