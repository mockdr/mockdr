meta {
  name: List agents
  type: http
  seq: 1
}

get {
  url: {{base_url}}/agents?limit=25
  body: none
  auth: none
}

params:query {
  limit: 25
  ~cursor:
  ~networkStatus: connected
  ~osType: windows
  ~isInfected: true
  ~isActive: true
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = res.body.data[0].id;
    if (value !== undefined && value !== null) bru.setVar("agent_id", String(value));
  } catch (e) {}
  try {
    const value = res.body.data[0].siteId;
    if (value !== undefined && value !== null) bru.setVar("site_id", String(value));
  } catch (e) {}
}
