meta {
  name: Create group
  type: http
  seq: 3
}

post {
  url: {{s1_base_url}}/groups
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "name": "New Group",
      "siteId": "{{site_id}}",
      "type": "static",
      "inherits": true
    }
  }
}

script:post-response {
  try {
    const value = res.body.data.id;
    if (value !== undefined && value !== null) bru.setVar("new_group_id", String(value));
  } catch (e) {}
}
