meta {
  name: List groups
  type: http
  seq: 1
}

get {
  url: {{base_url}}/groups?limit=50
  body: none
  auth: none
}

params:query {
  limit: 50
  ~siteId: "{{site_id}}"
  ~type: static
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = res.body.data[0].id;
    if (value !== undefined && value !== null) bru.setVar("group_id", String(value));
  } catch (e) {}
}
