meta {
  name: Create user
  type: http
  seq: 3
}

post {
  url: {{s1_base_url}}/users
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "email": "newuser@company.com",
      "fullName": "New User",
      "scope": "tenant",
      "role": "Viewer"
    }
  }
}

script:post-response {
  try {
    const value = res.body.data.id;
    if (value !== undefined && value !== null) bru.setVar("new_user_id", String(value));
  } catch (e) {}
}
