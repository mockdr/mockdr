meta {
  name: Generate API token
  type: http
  seq: 7
}

post {
  url: {{s1_base_url}}/users/generate-api-token
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {}
}

script:post-response {
  try {
    const value = res.body.data.token;
    if (value !== undefined && value !== null) bru.setVar("s1_token", String(value));
  } catch (e) {}
  try {
    const value = res.body.data.token;
    if (value !== undefined && value !== null) bru.setVar("token", String(value));
  } catch (e) {}
}
