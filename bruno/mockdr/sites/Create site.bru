meta {
  name: Create site
  type: http
  seq: 3
}

post {
  url: {{s1_base_url}}/sites
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "name": "New Site",
      "siteType": "Paid",
      "suite": "Core"
    }
  }
}

script:post-response {
  try {
    const value = res.body.data.id;
    if (value !== undefined && value !== null) bru.setVar("new_site_id", String(value));
  } catch (e) {}
}
