meta {
  name: List sites
  type: http
  seq: 1
}

get {
  url: {{base_url}}/sites?limit=50
  body: none
  auth: none
}

params:query {
  limit: 50
  ~state: active
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = res.body.data.sites[0].id;
    if (value !== undefined && value !== null) bru.setVar("site_id", String(value));
  } catch (e) {}
}
