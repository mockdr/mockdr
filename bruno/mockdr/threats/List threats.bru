meta {
  name: List threats
  type: http
  seq: 1
}

get {
  url: {{base_url}}/threats?limit=25
  body: none
  auth: none
}

params:query {
  limit: 25
  ~cursor:
  ~incidentStatus: unresolved
  ~mitigationStatus: mitigated
  ~confidenceLevel: malicious
  ~osType: windows
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = res.body.data[0].id;
    if (value !== undefined && value !== null) bru.setVar("threat_id", String(value));
  } catch (e) {}
}
