meta {
  name: Add threat note
  type: http
  seq: 8
}

post {
  url: {{base_url}}/threats/notes
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "text": "Investigated \u2014 confirmed malicious, escalated to IR team."
    },
    "filter": {
      "ids": [
        "{{threat_id}}"
      ]
    }
  }
}
