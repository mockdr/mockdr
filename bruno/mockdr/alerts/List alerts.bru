meta {
  name: List alerts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/cloud-detection/alerts?limit=25
  body: none
  auth: none
}

params:query {
  limit: 25
  ~cursor:
  ~severity: high
  ~incidentStatus: unresolved
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = res.body.data[0].alertInfo.alertId;
    if (value !== undefined && value !== null) bru.setVar("alert_id", String(value));
  } catch (e) {}
}
