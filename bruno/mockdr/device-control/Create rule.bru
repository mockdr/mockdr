meta {
  name: Create rule
  type: http
  seq: 2
}

post {
  url: {{s1_base_url}}/device-control
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{s1_token}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "ruleName": "Block USB Storage",
      "action": "Block",
      "interface": "USB",
      "ruleType": "class",
      "deviceClass": "08h",
      "status": "Enabled"
    },
    "filter": {
      "siteIds": [
        "{{site_id}}"
      ]
    }
  }
}

script:post-response {
  try {
    const value = (res.body.data[0] || res.body.data).id;
    if (value !== undefined && value !== null) bru.setVar("dc_rule_id", String(value));
  } catch (e) {}
}
