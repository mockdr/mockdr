meta {
  name: Create webhook subscription
  type: http
  seq: 2
}

post {
  url: {{base_url}}/_dev/webhooks
  body: json
  auth: none
}

headers {
  Authorization: ApiToken {{token}}
  Content-Type: application/json
}

body:json {
  {
    "url": "{{base_url}}/_dev/webhook-sink",
    "description": "SOAR integration test",
    "secret": "my-signing-secret-change-me",
    "event_types": [
      "threat.created",
      "threat.updated",
      "agent.offline"
    ],
    "active": true
  }
}

script:post-response {
  try {
    const value = (res.body.data || res.body).id;
    if (value !== undefined && value !== null) bru.setVar("webhook_id", String(value));
  } catch (e) {}
}
