meta {
  name: Export store snapshot
  type: http
  seq: 5
}

get {
  url: {{base_url}}/_dev/export
  body: none
  auth: none
}

headers {
  Authorization: ApiToken {{token}}
}

script:post-response {
  try {
    const value = JSON.stringify(res.body);
    if (value !== undefined && value !== null) bru.setVar("snapshot", String(value));
  } catch (e) {}
}
