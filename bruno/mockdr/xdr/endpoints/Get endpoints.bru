meta {
  name: Get endpoints
  type: http
  seq: 1
}

post {
  url: {{xdr_base_url}}/endpoints/get_endpoint/
  body: json
  auth: none
}

headers {
  x-xdr-auth-id: {{xdr_auth_id}}
  x-xdr-nonce: {{xdr_nonce}}
  x-xdr-timestamp: {{xdr_timestamp}}
  Authorization: {{xdr_auth_header}}
  Content-Type: application/json
}

body:json {
  {
    "request_data": {
      "filters": [
        {
          "field": "endpoint_status",
          "operator": "in",
          "value": [
            "connected"
          ]
        }
      ],
      "search_from": 0,
      "search_to": 25
    }
  }
}

script:post-response {
  try {
    const value = res.body.reply.endpoints[0].endpoint_id;
    if (value !== undefined && value !== null) bru.setVar("xdr_endpoint_id", String(value));
  } catch (e) {}
}
